# Copy to .env, fill in your own values, and load it as described in README.md.
JELLYFIN_URL=http://localhost:8096
JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key
PORT=8787
CACHE_SECONDS=300
# Optional: override the database location (default: facts.db beside app.py).
# FACT_DB_PATH=/var/lib/jellygenerator/facts.db
# Optional fact enrichment: use the same generated secret on server and client.
ENRICHMENT_TOKEN=
JELLYGEN_URL=http://localhost:8787
JELLYGEN_ENRICHMENT_TOKEN=
